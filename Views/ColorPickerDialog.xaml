<Window x:Class="HotelSystem.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор цвета" Height="420" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6FA"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Превью выбранного цвета -->
        <Border x:Name="PreviewBorder" Grid.Row="0" Height="60" CornerRadius="8" Margin="0,0,0,15" 
                BorderBrush="#DDD" BorderThickness="1" Background="#3498DB">
            <TextBlock x:Name="PreviewText" Text="#3498DB" Foreground="White" FontSize="18" FontWeight="Bold" 
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        
        <!-- R -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="R:" Width="20" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="52" Width="280" VerticalAlignment="Center"/>
            <TextBox x:Name="RedTextBox" Text="52" Width="50" Margin="10,0,0,0" TextAlignment="Center"/>
        </StackPanel>
        
        <!-- G -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="G:" Width="20" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="152" Width="280" VerticalAlignment="Center"/>
            <TextBox x:Name="GreenTextBox" Text="152" Width="50" Margin="10,0,0,0" TextAlignment="Center"/>
        </StackPanel>
        
        <!-- B -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="B:" Width="20" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="219" Width="280" VerticalAlignment="Center"/>
            <TextBox x:Name="BlueTextBox" Text="219" Width="50" Margin="10,0,0,0" TextAlignment="Center"/>
        </StackPanel>
        
        <!-- HEX -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10">
            <TextBlock Text="HEX:" Width="35" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="HexTextBox" Text="#3498DB" Width="120" Padding="5"/>
        </StackPanel>
        
        <!-- Быстрые цвета -->
        <StackPanel Grid.Row="5" Margin="0,10">
            <TextBlock Text="Быстрый выбор:" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel x:Name="QuickColorsPanel">
                <WrapPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Width" Value="32"/>
                        <Setter Property="Height" Value="32"/>
                        <Setter Property="Margin" Value="3"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </WrapPanel.Resources>
            </WrapPanel>
        </StackPanel>
        
        <!-- Кнопки -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,15,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Padding="15,8" Margin="0,0,10,0" Background="#95A5A6" Foreground="White" BorderThickness="0"/>
            <Button Content="OK" Click="Ok_Click" Padding="20,8" Background="#2ECC71" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
