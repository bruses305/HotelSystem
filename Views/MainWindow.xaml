<Window x:Class="HotelSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Hotel System" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#ECF0F1"
        AllowsTransparency="False"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Стиль кнопки меню с иконками Material Design -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8"
                                Margin="8,2">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                                         Width="22" Height="22"
                                                         Foreground="{TemplateBinding Foreground}"
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A6EA5"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль заголовков секций -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7A8B9B"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="16,16,16,6"/>
        </Style>

        <!-- Анимация появления фрейма -->
        <Storyboard x:Key="FrameEnterAnimation">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="#2C3E50" CornerRadius="0, 16, 16, 0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип и роль пользователя -->
                <StackPanel Grid.Row="0" Margin="20,30,20,20">
                    <materialDesign:PackIcon Kind="Hotel" Width="48" Height="48" Foreground="#3498DB" HorizontalAlignment="Center"/>
                    <TextBlock Text="Гостиничная" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" Margin="0,10,0,0"/>
                    <TextBlock Text="Система" FontSize="18" Foreground="#3498DB" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="UserRoleText" Text="Загрузка..." FontSize="12" Foreground="#A0A0A0" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>

                <!-- Меню навигации -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНОЕ" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button Tag="CalendarMonth" Content="Бронирования" Style="{StaticResource MenuButtonStyle}" Click="NavigateToBookings" x:Name="BookingsMenuItem"/>
                        <Button Tag="Door" Content="Номера" Style="{StaticResource MenuButtonStyle}" Click="NavigateToRooms"/>
                        <Button Tag="AccountGroup" Content="Клиенты" Style="{StaticResource MenuButtonStyle}" Click="NavigateToClients"/>
                        <Button Tag="Calendar" Content="Календарь" Style="{StaticResource MenuButtonStyle}" Click="NavigateToCalendar"/>
                        <Button Tag="CreditCardOutline" Content="Доп. расходы" Style="{StaticResource MenuButtonStyle}" Click="NavigateToExpenses" x:Name="ExpensesMenuItem"/>
                        <Button Tag="CreditCard" Content="Оплата услуг" Style="{StaticResource MenuButtonStyle}" Click="NavigateToServicesPayment"/>

                        <TextBlock Text="УПРАВЛЕНИЕ" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button Tag="ChartLine" Content="Финансы" Style="{StaticResource MenuButtonStyle}" Click="NavigateToFinance"/>
                        <Button Tag="RoomService" Content="Услуги" Style="{StaticResource MenuButtonStyle}" Click="NavigateToServices"/>
                        <Button Tag="AccountTie" Content="Сотрудники" Style="{StaticResource MenuButtonStyle}" Click="NavigateToEmployees" x:Name="EmployeesMenuItem"/>
                        <Button Tag="History" Content="Логи" Style="{StaticResource MenuButtonStyle}" Click="NavigateToLogs" x:Name="LogsMenuItem"/>
                        <Button Tag="FileChart" Content="Отчёты" Style="{StaticResource MenuButtonStyle}" Click="NavigateToReports" x:Name="ReportsMenuItem"/>
                        <Button Tag="Cog" Content="Настройки" Style="{StaticResource MenuButtonStyle}" Click="NavigateToSettings" x:Name="SettingsMenuItem"/>

                        <TextBlock Text="СИСТЕМА" Style="{StaticResource SectionHeaderStyle}"/>
                        <Button Tag="ShieldAccount" Content="Управление ролями" Style="{StaticResource MenuButtonStyle}" Click="ManageRoles_Click" x:Name="RolesMenuItem"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Кнопка выхода -->
                <StackPanel Grid.Row="2" Margin="16,0,16,20">
                    <Separator Background="#3A4A5A" Margin="0,0,0,12"/>
                    <Button Tag="ExitToApp" Content="Выйти" Style="{StaticResource MenuButtonStyle}" Click="Logout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Column="1" Background="#F4F6F9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель (хедер) -->
            <Border Grid.Row="0" Background="White" Padding="20,12" CornerRadius="0,0,16,16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PageTitle" Text="Бронирования" FontSize="24" FontWeight="SemiBold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Уведомления -->
                        <Grid>
                            <Button x:Name="NotificationsButton" Click="ShowNotifications_Click" ToolTip="Уведомления" Background="Transparent" BorderThickness="0" Padding="8,0">
                                <materialDesign:PackIcon Kind="BellOutline" Width="22" Height="22" Foreground="#5A6B7B"/>
                            </Button>
                            <Ellipse x:Name="NotificationBadge" Width="10" Height="10" Fill="#E74C3C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Visibility="Collapsed"/>
                        </Grid>
                        <!-- Профиль -->
                        <Button Click="ShowProfile_Click" ToolTip="Профиль" Background="Transparent" BorderThickness="0" Padding="8,0">
                            <materialDesign:PackIcon Kind="AccountCircle" Width="24" Height="24" Foreground="#3498DB"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Фрейм для контента -->
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Margin="20"/>
        </Grid>
    </Grid>
</Window>