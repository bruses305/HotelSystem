<Window x:Class="HotelSystem.Views.ForecastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Прогнозирование" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📊 Прогнозирование доходов и загрузки" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- Настройки прогноза -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Левая колонка - бронирования -->
                <Border Grid.Column="0" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="📅 Бронирования номеров:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        
                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BookingItemsPanel"/>
                        </ScrollViewer>
                        
                        <Button Content="+ Добавить бронирование" 
                                Click="AddBookingButton_Click"
                                Background="#3498DB" Foreground="White" Padding="10,8" Margin="0,10,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
                
                <!-- Правая колонка - услуги -->
                <Border Grid.Column="1" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="🧳 Услуги:" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                        
                        <ScrollViewer Height="300" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ServiceItemsPanel"/>
                        </ScrollViewer>
                        
                        <Button Content="+ Добавить услугу" 
                                Click="AddServiceButton_Click"
                                Background="#9B59B6" Foreground="White" Padding="10,8" Margin="0,10,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        
        <!-- Результаты прогноза -->
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Результаты прогноза:" 
                           FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                
                <Grid Grid.Row="1" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Border Background="#27AE60" CornerRadius="8" Padding="15">
                        <StackPanel>
                            <TextBlock Text="Доход" Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="ForecastIncomeText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#E74C3C" CornerRadius="8" Padding="15" Margin="7,0">
                        <StackPanel>
                            <TextBlock Text="Расходы" Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="ForecastExpenseText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#3498DB" CornerRadius="8" Padding="15" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Прибыль" Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="ForecastProfitText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ForecastDetailsPanel"/>
                </ScrollViewer>
                
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Закрыть" Click="Close_Click" Padding="15,8" Background="#95A5A6" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
