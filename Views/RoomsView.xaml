<Page x:Class="HotelSystem.Views.RoomsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:HotelSystem.Helpers"
      Background="#ECF0F1">
    <Page.Resources>
        <helpers:CurrencyDisplayConverter x:Key="CurrencyDisplayConverter"/>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,5" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,0">
                    <Button x:Name="AddRoomButton" Content="+ Добавить номер" Click="AddRoom_Click" Background="#27AE60" Foreground="White" Padding="15,8" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,15,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button x:Name="IncreaseProfitButton" Content="📈 Увеличить прибыль" Click="IncreaseProfit_Click" 
                            Background="#9CA3AF" Foreground="White" Padding="15,5" BorderThickness="0" IsEnabled="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="TypeFilterComboBox" Width="150" Padding="8,5" SelectedIndex="-1" SelectionChanged="TypeFilterComboBox_SelectionChanged">
                        <ComboBoxItem Content="Все типы" Tag="All"/>
                        <ComboBoxItem Content="Стандарт" Tag="Standard"/>
                        <ComboBoxItem Content="Люкс" Tag="Lux"/>
                        <ComboBoxItem Content="Апартамент" Tag="Apartment"/>
                    </ComboBox>
                    <TextBox x:Name="SearchTextBox" Width="250" Padding="8,5" Margin="15,0,0,0" 
                             ToolTip="Поиск по названию или описанию"
                             VerticalAlignment="Center" TextChanged="SearchTextBox_TextChanged"/>
                    <TextBlock Text="🔍" FontSize="16" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" BorderThickness="0" MouseDoubleClick="RoomsGrid_MouseDoubleClick" SelectionChanged="RoomsGrid_SelectionChanged" AllowDrop="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="120"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="115"/>
                    <DataGridTextColumn Header="Площадь" Binding="{Binding Area, StringFormat={}{0:N1} м²}" Width="90"/>
                    <DataGridTemplateColumn Header="Цена" MinWidth="100" MaxWidth="400">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source=Цена, Converter={StaticResource CurrencyDisplayConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Price}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Прибыль" MinWidth="100" MaxWidth="400">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source=Прибыль, Converter={StaticResource CurrencyDisplayConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Profit}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Себестоимость" MinWidth="100" MaxWidth="400">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source=Себестоимость, Converter={StaticResource CurrencyDisplayConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Cost}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Вместимость" MinWidth="100" MaxWidth="400">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Source=Вместимость, Converter={StaticResource PeopleCountConverter}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Capacity, Converter={StaticResource PeopleCountConverter}}" HorizontalAlignment="Right"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Статус" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Свободен"><Setter Property="Background" Value="#27AE60"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Занят"><Setter Property="Background" Value="#E74C3C"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Уборка"><Setter Property="Background" Value="#F39C12"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Ремонт"><Setter Property="Background" Value="#95A5A6"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="320"/>
                    <DataGridTemplateColumn Header="Действия" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Ред." Click="EditRoom_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="5"/>
                                    <Button Content="Удал." Click="DeleteRoom_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="5"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
