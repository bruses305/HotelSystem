<Window x:Class="HotelSystem.Views.RoomProfitIncreaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Увеличить прибыль номеров" 
        MinHeight="500" MaxHeight="800" MinWidth="600" MaxWidth="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF3F4F6">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="📈 Увеличение прибыли номеров" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
        
        <!-- Ввод процентов -->
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Процент увеличения" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="PercentageTextBox" Padding="10" FontSize="16" Text="100" Width="150" Margin="0,0,10,0"/>
                    <TextBlock Text="%" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#6B7280"/>
                </StackPanel>
                <TextBlock x:Name="InfoText" Text="100% = прибыль не изменится, 150% = увеличение на 50%, 200% = удвоение прибыли" 
                           FontSize="11" Foreground="#6B7280" Margin="0,8,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        
        <!-- Статистика -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="SelectedCountText" Text="Выбрано номеров: 0" FontSize="14" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock x:Name="PreviewCountText" Text="Предварительный просмотр:" FontSize="14" Foreground="#6B7280"/>
        </StackPanel>
        
        <!-- Список изменений -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ChangesPanel">
                    <TextBlock Text="Выберите номера для просмотра изменений..." Foreground="#9CA3AF" FontStyle="Italic" HorizontalAlignment="Center" Margin="20"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- Кнопки -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="CancelButton" Content="Отмена" Click="CancelButton_Click" 
                    Padding="20,8" Margin="0,0,10,0" Background="#EF4444" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="ApplyButton" Content="Применить" Click="ApplyButton_Click" 
                    Padding="20,8" Background="#3B82F6" Foreground="White" BorderThickness="0" IsEnabled="False">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
