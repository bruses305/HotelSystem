<Page x:Class="HotelSystem.Views.ExpensesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:models="clr-namespace:HotelSystem.Models.Entities"
      xmlns:views="clr-namespace:HotelSystem.Views"
      xmlns:helpers="clr-namespace:HotelSystem.Helpers"
      Title="Дополнительные расходы" 
      Background="#FFF3F4F6"
      Language="ru-RU">

    <Page.Resources>
        <views:ExpenseStatusConverter x:Key="ExpenseStatusConverter" />
        <views:ExpenseStatusTextConverter x:Key="ExpenseStatusTextConverter" />
        <helpers:QuantityWithUnitConverter x:Key="QuantityWithUnitConverter" />
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок и кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,20">
            <TextBlock Text="Дополнительные расходы" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,20">
            <Button x:Name="AddExpenseButton" Content="Добавить расход" Click="AddExpense_Click" 
                    Padding="15,5" Margin="0,0,10,0" Background="#3B82F6" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Button x:Name="PaySalariesButton" Content="Выплатить ЗП сотрудникам" Click="PaySalaries_Click" 
                    Padding="15,5" Margin="0,0,10,0" Background="#8B5CF6" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Button x:Name="UpdatePricesButton" Content="🔄 Обновить цены" Click="UpdatePrices_Click" 
                    Padding="15,5" Margin="0,0,10,0" Background="#F59E0B" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <Button x:Name="PayAllButton" Content="Оплатить всё" Click="PayAll_Click" 
                    Padding="15,0" Background="#10B981" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
        
        <!-- Таблица расходов -->
        <DataGrid x:Name="ExpensesGrid"  Grid.Row="1"  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" BorderThickness="0" MouseDoubleClick="ExpensesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                <DataGridTemplateColumn  MinWidth="100" MaxWidth="400">
                    <DataGridTemplateColumn.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Source=Сумма, Converter={StaticResource CurrencyDisplayConverter}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.HeaderTemplate>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Expense">
                            <TextBlock Text="{Binding Amount}" HorizontalAlignment="Right"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Количество" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text">
                                <Setter.Value>
                                    <MultiBinding Converter="{StaticResource QuantityWithUnitConverter}">
                                        <Binding Path="Quantity"/>
                                        <Binding Path="UnitName"/>
                                    </MultiBinding>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата оплаты" Binding="{Binding LastPaymentDate, StringFormat={}{0:dd.MM.yyyy}}" Width="110"/>
                <DataGridTemplateColumn Header="Статус" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Expense">
                            <Border CornerRadius="4" Padding="8,4" 
                                    Background="{Binding LastPaymentDate, Converter={StaticResource ExpenseStatusConverter}, FallbackValue='#EF4444'}">
                                <TextBlock Text="{Binding LastPaymentDate, Converter={StaticResource ExpenseStatusTextConverter}, FallbackValue='Не оплачено'}"
                                          Foreground="White" FontSize="12" HorizontalAlignment="Center"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Действия" Width="320">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="models:Expense">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Оплатить" Click="PayExpense_Click" Tag="{Binding}" 
                                        Padding="8,6" Margin="0,0,5,0" Background="#10B981" Foreground="White" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Редактировать" Click="EditExpense_Click" Tag="{Binding}" 
                                        Padding="8,6" Margin="0,0,5,0" Background="#6B7280" Foreground="White" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="Удалить" Click="DeleteExpense_Click" Tag="{Binding}" 
                                        Padding="8,6" Background="#EF4444" Foreground="White" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>