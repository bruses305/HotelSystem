<Window x:Class="HotelSystem.Views.ExpensePriceUpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление цен расходов" 
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFF3F4F6"
        Language="ru-RU">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="🔄 Обновление цен с сайтов" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
        
        <!-- Прогресс -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock x:Name="ProgressText" Text="Подготовка..." FontSize="14" Margin="0,0,0,8"/>
            <ProgressBar x:Name="ProgressBar" Height="20" Minimum="0" Maximum="100" Value="0"/>
            <TextBlock x:Name="CurrentItemText" Text="" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
        </StackPanel>
        
        <!-- Статистика -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="SuccessCountText" Text="✅ Успешно: 0" Foreground="#10B981" FontWeight="SemiBold" Margin="0,0,20,0"/>
            <TextBlock x:Name="FailCountText" Text="❌ Ошибок: 0" Foreground="#EF4444" FontWeight="SemiBold"/>
        </StackPanel>
        
        <!-- Результаты -->
        <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultsPanel">
                    <TextBlock Text="Результаты появятся здесь..." Foreground="#9CA3AF" FontStyle="Italic"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        
        <!-- Кнопка закрыть -->
        <Button Grid.Row="4" x:Name="CloseButton" Content="Закрыть" Click="CloseButton_Click" 
                HorizontalAlignment="Right" Padding="20,8" Margin="0,15,0,0"
                Background="#3B82F6" Foreground="White" BorderThickness="0" IsEnabled="False">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>
