<Window x:Class="HotelSystem.Views.RoleManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление ролями и правами" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Управление ролями и правами доступа" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Список ролей -->
            <Border Grid.Column="0" Background="#F5F5F5" CornerRadius="5" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Роли" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <ListBox x:Name="RolesListBox" Grid.Row="1" 
                             ItemsSource="{Binding Roles}"
                             SelectedItem="{Binding SelectedRole}"
                             SelectionChanged="RolesListBox_SelectionChanged"
                             DisplayMemberPath="Name"
                             Margin="0,0,0,10"/>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="AddRoleButton" Content="+" Width="30" Height="30"
                                Click="AddRole_Click"
                                Padding="0"
                                Margin="-10,0,0,5"/>
                        <Button x:Name="DeleteRoleButton" Content="✕" Width="30" Height="30" 
                                Click="DeleteRole_Click"
                                Padding="0"
                                Margin="10,0,0,5"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Права роли -->
            <Border Grid.Column="2" Background="#F5F5F5" CornerRadius="5" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Название роли: " FontSize="14" VerticalAlignment="Center"/>
                        <TextBox x:Name="RoleNameTextBox" Width="200" Margin="5,0,15,0" Padding="5"/>
                        <TextBlock Text="Описание: " FontSize="14" VerticalAlignment="Center"/>
                        <TextBox x:Name="RoleDescriptionTextBox" Width="250" Margin="5,0,15,0" Padding="5"/>
                        <TextBlock Text="Цвет:" FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Button x:Name="RoleColorButton" Width="100" Height="32" Click="RoleColorButton_Click" Padding="5,2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="ColorBorder" Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="#CCC" BorderThickness="1">
                                        <TextBlock x:Name="ColorText" Text="{TemplateBinding Content}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SaveRoleButton" Content="Сохранить" Click="SaveRole_Click" Margin="15,0,0,0" Padding="10,5"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PermissionsItemsControl" ItemsSource="{Binding Permissions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White" CornerRadius="3" Padding="10" Margin="0,0,0,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Permission.Name}" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Permission.Description}" FontSize="11" Foreground="#666"/>
                                                <TextBlock>
                                                    <Run Text="Категория:" FontWeight="Bold"/>
                                                    <Run Text="{Binding Permission.Category}"/>
                                                    <Run Text=" Тип:" FontWeight="Bold"/>
                                                    <Run Text="{Binding Permission.Type}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            
                                            <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                      VerticalAlignment="Top" Margin="10,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button x:Name="SavePermissionsButton" Content="Сохранить права" Click="SavePermissions_Click" Padding="15,8" Margin="0,0,10,0"/>
                        <Button Content="Отмена" Click="Cancel_Click" Padding="15,8"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Закрыть" Click="Close_Click" Padding="20,10"/>
        </StackPanel>
    </Grid>
</Window>