<helpers:DialogBase xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:HotelSystem.Helpers"
                    x:Class="HotelSystem.Views.RoomDialog"
                    Title="Номер" Height="650" Width="400"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize"
                    Background="#ECF0F1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Номер" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Название" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox" Padding="10" Margin="0,0,0,15"/>
                <TextBlock Text="Тип номера" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="TypeComboBox" Margin="0,0,0,15" Padding="10">
                    <ComboBoxItem Content="Стандартный" Tag="Стандартный"/>
                    <ComboBoxItem Content="Люкс" Tag="Люкс"/>
                    <ComboBoxItem Content="Апартаменты" Tag="Апартаменты"/>
                </ComboBox>
                <TextBlock Text="Площадь помещения (м²)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="AreaTextBox" Padding="10" Margin="0,0,0,15"/>
                <TextBlock Text="Прибыль за сутки (руб.)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="ProfitTextBox" Padding="10" Margin="0,0,0,15"/>
                <TextBlock Text="Себестоимость за сутки (руб.)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="CostTextBox" IsReadOnly="True" Padding="10" Margin="0,0,0,15" Background="#E5E7EB"/>
                <TextBlock Text="Цена за сутки (авторасчёт)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="PriceTextBox" IsReadOnly="True" Padding="10" Margin="0,0,0,15" Background="#E5E7EB"/>
                <TextBlock Text="Вместимость (чел.)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="CapacityTextBox" Padding="10" Margin="0,0,0,15"/>
                <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" Margin="0,0,0,15"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Padding="20,5" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="Save_Click" Background="#27AE60" Foreground="White" Padding="20,5" BorderThickness="0">
                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</helpers:DialogBase>
