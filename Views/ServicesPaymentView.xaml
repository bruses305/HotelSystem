<Page x:Class="HotelSystem.Views.ServicesPaymentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#ECF0F1"
      Language="ru-RU">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddServicePaymentButton" Content="+ Добавить услугу" Click="AddServicePayment_Click" Background="#27AE60" Foreground="White" Padding="15,8" BorderThickness="0" HorizontalAlignment="Left">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Border Grid.Column="1" Background="#EEF2F7" Width="280" CornerRadius="6" Padding="8,4" Margin="20,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="SearchTextBox" Width="230" BorderThickness="0" Background="Transparent"
                                 TextChanged="SearchTextBox_TextChanged" KeyDown="SearchTextBox_KeyDown"/>
                    </StackPanel>
                </Border>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0">
                    <TextBlock Text="С:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker x:Name="StartDatePicker" Width="120" SelectedDateChanged="DateFilterChanged"/>
                    <TextBlock Text="По:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                    <DatePicker x:Name="EndDatePicker" Width="120" SelectedDateChanged="DateFilterChanged"/>
                </StackPanel>
                <Button Grid.Column="3" Content="Сбросить" Click="ResetFilters_Click" Margin="30,0,0,0" Padding="10,6"
                                       Background="#7f8c8d" Foreground="White" BorderThickness="0" Cursor="Hand" >
                </Button>
                
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.08"/>
            </Border.Effect>
            <DataGrid x:Name="PaymentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White" BorderThickness="0" MouseDoubleClick="PaymentsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Дата" Binding="{Binding TransactionDate, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="200"/>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding ServiceName}" Width="150"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="100"/>
                    <DataGridTextColumn Header="Сумма" 
                                        Binding="{Binding Amount, Converter={StaticResource PriceConverter}}" 
                                        Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="TextAlignment" Value="Right"/>
                                <Setter Property="Margin" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
