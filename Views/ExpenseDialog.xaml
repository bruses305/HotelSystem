<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:HotelSystem.Helpers"
                    x:Class="HotelSystem.Views.ExpenseDialog"
                    Title="Дополнительный расход" MinHeight="550" MaxHeight="650" Width="500" 
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize"
                    Background="#ECF0F1"
                    Language="ru-RU">
    <Window.Resources>
        <helpers:VisibilityToBooleanConverter x:Key="VisibilityToBooleanConverter"/>
        <helpers:InvertedVisibilityConverter x:Key="InvertedVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Дополнительный расход" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="Название расхода" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="NameTextBox" Padding="10" Margin="0,0,0,15"/>
                
                <TextBlock Text="Категория" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CategoryComboBox" Margin="0,0,0,15" Padding="10"/>
                
                <!-- Сумма с разбиением -->
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Сумма Руб." FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="AmountTextBox" Padding="10" IsEnabled="{Binding ElementName=SplitGrid, Path=Visibility, Converter={StaticResource VisibilityToBooleanConverter}}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✂️" Width="40" Padding="0" Margin="10,25,0,0" Click="SplitAmount_Click" ToolTip="Разбить на единицы"/>
                </Grid>
                
                <!-- Разбитые поля (скрыты по умолчанию) -->
                <Grid x:Name="SplitGrid" Visibility="Collapsed" Margin="0,0,0,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,5,10">
                        <TextBlock x:Name="UnitLabelText" Text="Цена за 1" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="UnitPriceTextBox" Padding="10" TextChanged="UnitPriceTextBox_TextChanged"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="5,0,0,10">
                        <TextBlock Text="Количество" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="QuantityTextBox" Padding="10" TextChanged="QuantityTextBox_TextChanged"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                        <TextBlock Text="Единица измерения" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox x:Name="UnitNameTextBox" Padding="10" TextChanged="UnitNameTextBox_TextChanged" ToolTip="Пример: кВт·ч, м³, шт"/>
                    </StackPanel>
                </Grid>
                
                <!-- Настройка парсинга (скрыта вместе с разбитыми полями) -->
                <Grid x:Name="ParsingGrid" Margin="0,0,0,15">
                    <Grid.Visibility>
                        <Binding ElementName="SplitGrid" Path="Visibility">
                            <Binding.Converter>
                                <helpers:InvertedVisibilityConverter/>
                            </Binding.Converter>
                        </Binding>
                    </Grid.Visibility>
                    <Border Background="White" BorderBrush="#BDC3C7" BorderThickness="1" CornerRadius="6" Padding="12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="🌐 Автообновление цены" FontWeight="SemiBold"/>
                                    <TextBlock Text="Парсинг цены с сайта" FontSize="12" Foreground="#7F8C8D"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="⚙ Настроить" Click="ParsingSettings_Click" Padding="12,6" Background="#9B59B6" Foreground="White" BorderThickness="0">
                                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ParsingStatusText" Text="Не настроено" FontSize="12" Foreground="#7F8C8D" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <TextBlock Text="Последняя дата оплаты" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <DatePicker x:Name="LastPaymentDatePicker" Margin="0,0,0,15" Padding="10"/>
                
                <TextBlock Text="Описание" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="DescriptionTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Padding="10" Margin="0,0,0,15"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Padding="20,5" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="Save_Click" Background="#27AE60" Foreground="White" Padding="20,5" BorderThickness="0">
                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>