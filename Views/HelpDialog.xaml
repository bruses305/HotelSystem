<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="HotelSystem.Views.HelpDialog"
                    Title="Помощь" Height="400" Width="500"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize"
                    Background="White"
                    Language="ru-RU">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
        <ScrollViewer Grid.Row="1">
            <TextBlock x:Name="ContentText" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
        </ScrollViewer>
        <Button Grid.Row="2" Content="Закрыть" Click="Close_Click" Padding="20,8" HorizontalAlignment="Right" Margin="0,15,0,0"/>
    </Grid>
</Window>