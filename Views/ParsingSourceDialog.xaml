<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    x:Class="HotelSystem.Views.ParsingSourceDialog"
                    Title="Настройка парсинга цены" Height="550" Width="600"
                    WindowStartupLocation="CenterOwner"
                    ResizeMode="NoResize"
                    Background="#F5F6FA"
                    Language="ru-RU">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="⚙ Настройка парсинга цены" FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Укажите URL и XPath для автоматического получения цены" FontSize="13" Foreground="#7F8C8D" Margin="0,0,0,20"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- URL -->
                <TextBlock Text="Ссылка на страницу с ценой" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="UrlTextBox" Padding="10" Margin="0,0,10,15"/>
                    <Button Grid.Column="1" Content="❓" Width="35" Margin="0,0,0,15" Click="HelpUrl_Click" ToolTip="Помощь"/>
                </Grid>

                <!-- XPath -->
                <TextBlock Text="XPath к элементу цены" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="XPathTextBox" Padding="10" Margin="0,0,10,15"/>
                    <Button Grid.Column="1" Content="❓" Width="35" Margin="0,0,0,15" Click="HelpXPath_Click" ToolTip="Помощь"/>
                </Grid>

                <!-- Class-based selector (readonly) -->
                <TextBlock Text="CSS-селектор (автоматически)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="ClassSelectorTextBox" Padding="10" Margin="0,0,0,15" IsReadOnly="True" Background="#ECF0F1" Foreground="#7F8C8D"/>

                <!-- Тестирование -->
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🧪 Проверка парсинга" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Button x:Name="TestButton" Content="Проверить" Click="Test_Click" 
                                Padding="15,8" Background="#3498DB" Foreground="White" BorderThickness="0" HorizontalAlignment="Left">
                            <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
                        </Button>
                        <TextBlock x:Name="TestResultText" Margin="0,10,0,0" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Last parsed info -->
                <Border x:Name="LastParseBorder" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="✅ Последнее успешное получение" FontWeight="SemiBold" Foreground="#2E7D32" Margin="0,0,0,5"/>
                        <TextBlock x:Name="LastParseDateText" FontSize="12" Foreground="#388E3C"/>
                        <TextBlock x:Name="LastParseValueText" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Padding="20,8" Margin="0,0,10,0"/>
            <Button Content="Сохранить" Click="Save_Click" Background="#27AE60" Foreground="White" Padding="20,8" BorderThickness="0">
                <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border></ControlTemplate></Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>